{
  "angular.forceStrictTemplates": false,
  "claudeCode.preferredLocation": "panel",
  "debug.toolBarLocation": "docked",
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.useInlineViewWhenSpaceIsLimited": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "always"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontSize": 12,
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": "active",
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.minimap.showSlider": "always",
  "editor.minimap.size": "fit",
  "editor.renderControlCharacters": true,
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [120],
  "editor.tabSize": 2,
  "editor.unicodeHighlight.invisibleCharacters": true,
  "editor.unicodeHighlight.ambiguousCharacters": true,
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.java$",
        "cmd": "java -jar /home/cyril/bin/google-java-format-1.35.0-all-deps.jar --replace ${file}"
      }
    ]
  },
  "eslint.validate": ["javascript", "typescript", "html"],
  "extensions.autoUpdate": false,
  "files.exclude": {
    "**/.classpath": true,
    "**/.factorypath": true,
    "**/*.git": true,
    "**/.project": true,
    "**/.settings": true,
    "**/node_modules": true
  },
  "git.autofetch": false,
  "git.autofetchPeriod": 1200,
  "git.blame.editorDecoration.enabled": true,
  "git.openRepositoryInParentFolders": "never",
  "git-log--graph.branch-colors": [
    "#a77cbf",
    "#f57a9c",
    "#f99f66",
    "#ffd758",
    "#a6d472",
    "#31b5d1"
  ],
  "git-log--graph.branch-color-custom-mapping": {
    "main": "#888888"
  },
  "gradle.nestedProjects": true,
  "java.completion.importOrder": ["#"],
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "/home/cyril/.sdkman/candidates/java/21.0.7-tem",
      "default": true
    },
    {
      "name": "JavaSE-25",
      "path": "/home/cyril/.sdkman/candidates/java/25.0.2-tem",
      "default": false
    }
  ],
  "java.debug.settings.hotCodeReplace": "manual",
  "java.gradle.buildServer.enabled": "on",
  "java.import.gradle.version": "8.14.2",
  "java.import.gradle.wrapper.enabled": true,
  "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx1G -Xms100m -javaagent:\"/home/cyril/.vscode-oss/extensions/gabrielbb.vscode-lombok-1.0.1-universal/server/lombok.jar\"",
  "java.server.launchMode": "Standard",
  "java.settings.url": "~/dev/vscode-java.prefs", //".settings/org.eclipse.jdt.core.prefs",
  "[java]": {
    "editor.defaultFormatter": null,
    "editor.formatOnSave": false
  },
  "prettier.printWidth": 120,
  "redhat.telemetry.enabled": true,
  "redHatDependencyAnalytics.gradle.preferWrapper": "true",
  "redHatDependencyAnalytics.npm.executable.path": "/home/cyril/.nvm/versions/node/v22.17.1/bin/npm",
  "sonarlint.connectedMode.connections.sonarqube": [
    {
      "serverUrl": "https://sonarqube.orpheo.dev",
      "connectionId": "https-sonarqube-orpheo-dev"
    }
  ],
  "sonarlint.pathToNodeExecutable": "/home/cyril/.nvm/versions/node/v22.17.1/bin/node",
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.lint.invalidConfigPath": "ignore",
  "tailwindCSS.validate": true,
  "terminal.integrated.confirmOnExit": "always",
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.env.linux": {
    "GTK_PATH": ""
  },
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.scrollback": 100000,
  "terminal.integrated.shellIntegration.enabled": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "visualvm.installation.visualvmPath": "/home/cyril/bin/visualvm_22/bin",
  "window.titleBarStyle": "custom",
  "workbench.colorTheme": "Default Light+",
  "workbench.list.horizontalScrolling": true,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll": "never",
      "source.organizeImports": "always"
    }
  }
}
